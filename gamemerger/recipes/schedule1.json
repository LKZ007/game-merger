      {
        "ext": [
          ".dll"
        ],
        "dest": "Mods"
      },
      {
        "ext": [
          ".cfg",
          ".json"
        ],
        "dest": "UserData"
      }
    ]
  },
  "frameworks": [
    {
      "id": "melonloader",
      "name": "MelonLoader (mod loader)",
      "github": "LavaGang/MelonLoader",
      "asset": "(?i)melonloader\\.x64\\.zip$"
    }
  ],
  "themes": [
    {
      "id": "hoodwarfare",
