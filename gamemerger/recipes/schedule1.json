      "source_match": [
        "hood warfare"
      ],
      "description": "Pushes Schedule I toward a hood combat game: more weapons, tougher gang and police fights, and extra areas. Hood Warfare's own files are never copied, only Schedule I mods.",
      "frameworks": [
        "melonloader"
      ],
      "slots": [
        {
          "name": "Weapons",
          "search": "weapon"
        },
        {
          "name": "Gangs, NPCs and combat",
          "search": "combat"
        },
        {
          "name": "Police and wanted level",
          "search": "police"
        },
        {
          "name": "Vehicles",
          "search": "vehicle"
        }
      ]
    },
    {
