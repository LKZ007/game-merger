{
  "id": "schedule1",
  "name": "Schedule I",
  "exe": [
    "Schedule I.exe"
  ],
  "steam_appids": [
    "3164500"
  ],
  "nexus_domain": "schedule1",
  "logs": [
    "MelonLoader/Latest.log"
  ],
  "saves": [
    "{LocalLow}/TVGS/Schedule I/Saves"
  ],
  "processes": [
    "Schedule I.exe"
  ],
  "layout": {
    "root_markers": [
      "Mods",
      "UserLibs",
      "Plugins",
      "UserData",
      "MelonLoader"
    ],
    "loose_rules": [
      {
        "ext": [
          ".dll"
        ],
        "dest": "Mods"
      },
      {
        "ext": [
          ".cfg",
          ".json"
        ],
        "dest": "UserData"
      }
    ]
  },
  "frameworks": [
    {
      "id": "melonloader",
      "name": "MelonLoader (mod loader)",
      "github": "LavaGang/MelonLoader",
      "asset": "(?i)melonloader\\.x64\\.zip$"
    },
    {
      "id": "s1api",
      "name": "S1API (for Frankenstein's item menu and story mode)",
      "github": "ifBars/S1API",
      "asset": "(?i)S1API.*\\.zip$",
      "manual_url": "https://thunderstore.io/c/schedule-i/p/ifBars/S1API_Forked/"
    }
  ],
  "themes": [
    {
      "id": "hoodwarfare",
      "name": "Hood Warfare style: guns and gang fights",
      "from_game": "Hood Warfare 2",
      "source_match": [
        "hood warfare"
      ],
      "description": "Pushes Schedule I toward a hood combat game: more weapons, tougher gang and police fights, and extra areas. Hood Warfare's own files are never copied, only Schedule I mods.",
      "frameworks": [
        "melonloader",
        "s1api"
      ],
      "slots": [
        {
          "name": "Hood Warfare guns (AK, SMG, sniper, RPG, minigun)",
