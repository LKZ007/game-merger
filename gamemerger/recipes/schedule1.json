      "source_match": [
        "grand theft auto",
        "gta"
      ],
      "description": "Adds GTA-style vehicles, police chases and more freedom to Schedule I's town.",
      "frameworks": [
        "melonloader"
      ],
      "slots": [
        {
          "name": "Vehicles",
          "search": "vehicle"
        },
        {
          "name": "Police and wanted level",
          "search": "police"
        },
        {
          "name": "Quality of life",
          "search": "quality of life"
        }
      ],
